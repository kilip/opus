# Opus configuration
# Note: .env in the working directory is auto-loaded on startup (existing environment variables take precedence).

# Application
APP_NAME=opus
# Opus home directory for repos, worktrees, and node config (defaults to ~/.opus)
APP_HOME=
APP_HOST=0.0.0.0
APP_PORT=7880
# Canonical public base URL for OAuth callbacks, HSTS, and WebSocket/CSRF origins
APP_BASE_URL=http://localhost:7880
# Comma-separated list of allowed CORS / redirect / WebSocket origins
APP_TRUSTED_ORIGINS=
# Comma-separated list of trusted reverse proxy IPs or CIDRs
APP_TRUSTED_PROXIES=
APP_LOG_LEVEL=info
APP_VERSION=
# Allow starting with a binary older than the stored schema version
APP_ALLOW_DOWNGRADE=false

# Timeouts & Limits
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=10s
APP_BODY_LIMIT=4194304

# Database
# SQLite database connection string (WAL, busy_timeout, foreign_keys, and _txlock=immediate are added automatically)
APP_DATABASE_URL=file:opus.db?_pragma=foreign_keys(ON)&_pragma=busy_timeout(5000)

# Auth & OAuth
# Secret key used to sign session cookies (min 32 chars; auto-persisted in APP_HOME/auth_secret if unset)
AUTH_SECRET=
# Session duration / time-to-live
AUTH_SESSION_TTL=720h
# First-run setup token for /onboarding (auto-generated and printed to stderr if unset)
AUTH_SETUP_TOKEN=
# Session cookie Secure flag policy: auto, true, or false
AUTH_COOKIE_SECURE=auto
# GitHub OAuth credentials
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Facebook OAuth credentials
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# SMTP Mailer (falls back to console mailer when APP_SMTP_HOST is unset)
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_FROM=

# Tracker, Runs & Worker
# Interval between tracker sync polling cycles
TRACKER_POLL_INTERVAL=60s
# Interval between run reconciler polling cycles
RUN_POLL_INTERVAL=30s
# Maximum duration for an active run stage before timeout
RUN_STAGE_TIMEOUT=2h
# Grace period before failing active runs on a disconnected worker node
RUN_NODE_GRACE=2m
# Path or binary name for the agy ACP CLI on worker nodes
WORKER_AGY_BIN=agy

# Notifications (Telegram)
# Telegram Bot API token (disables notifier when empty)
NOTIFY_TELEGRAM_BOT_TOKEN=
# Telegram chat ID for run.finished and node.offline alerts
NOTIFY_TELEGRAM_CHAT_ID=

# Sentry
APP_SENTRY_DSN=
APP_SENTRY_ENVIRONMENT=development
APP_SENTRY_TRACES_SAMPLE_RATE=1.0

# UI build and dev only (not read by the Go server)
# Allowed hosts for Vite dev server
APP_ALLOWED_HOSTS=localhost
# Sentry Vite plugin auth token for uploading sourcemaps during UI build
APP_SENTRY_AUTH_TOKEN=
