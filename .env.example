# Server / API
PORT=3000
NODE_ENV=development
DATA_DIR=./data
WORKSPACES_DIR=./workspaces

# Database (packages/db)
DATABASE_URL=./data/opus.sqlite

# Better Auth (packages/auth)
BETTER_AUTH_SECRET=development-auth-secret-change-in-production-1234567890
BETTER_AUTH_URL=http://localhost:3000

# Social Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mailer / SMTP for OTP (Optional - falls back to console log if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Opus <noreply@opus.local>"
